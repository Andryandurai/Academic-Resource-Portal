# ---------------------------------------------------------------------------
# REC AI&DS Academic Resource Portal
# Copy to backend/.env (or export these) and replace every value before deploying.
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
# REQUIRED in production. The server refuses to boot without it when DEBUG=0.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
REC_SECRET_KEY=""

# 1 in development, 0 in production. Defaults to 0 on a managed host.
REC_DEBUG="1"

# Comma-separated hostnames. Required when DEBUG=0.
REC_ALLOWED_HOSTS="localhost,127.0.0.1"

# --- Database --------------------------------------------------------------
# Omit for the default SQLite file at backend/rec_aids.sqlite3.
# PostgreSQL for production — including Supabase's PostgreSQL — needs no code
# change to switch, just this value:
# REC_DATABASE_URL="postgresql://user:password@localhost:5432/rec_aids?sslmode=require"
#
# For Supabase specifically: Project Settings -> Database -> Connection string
# -> URI. The direct connection (port 5432, db.<ref>.supabase.co) resolves
# over IPv6 only and can be throttled after repeated failed-auth attempts;
# the Session Pooler or Transaction Pooler (both go through a different,
# IPv4-reachable host) are the more robust default — see
# docs/SUPABASE_SETUP.md for what was actually observed. Keep
# "?sslmode=require" — Supabase requires TLS.
# REC_DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"
#
# If your password contains any of : / ? # [ ] @ ! $ & ' ( ) * + , ; = %
# percent-encode it first — an unencoded "#" in particular silently
# truncates the rest of the URL (it's the fragment delimiter), which shows
# up as a confusing "port could not be parsed" error with no obvious link
# to the password. python -c "from urllib.parse import quote; print(quote('pw', safe=''))"
REC_DATABASE_URL=""

# A plain DATABASE_URL (no REC_ prefix) is also read as a fallback, for hosts
# that inject that name automatically. Setting REC_DATABASE_URL above always
# takes priority over it, so there is never a conflict between the two.
# DATABASE_URL=""

# --- Uploads ---------------------------------------------------------------
# Where resource files are written when no REC_S3_* below is set. Never inside
# frontend/ or STATIC_ROOT: files are served only through the authenticated
# download endpoint, whichever storage backend holds them.
REC_MEDIA_ROOT=""
REC_MAX_UPLOAD_MB="25"

# --- File storage (optional — local disk unless this is set) ---------------
# A free host's local disk is usually ephemeral, so setting REC_S3_ACCESS_KEY_ID
# switches uploaded resource files to any S3-compatible bucket instead — this
# is how Supabase Storage plugs in, since its Storage product speaks the S3
# API. Not used yet in this deployment; local disk (REC_MEDIA_ROOT above) is
# still the default with all of these left blank.
#
# For Supabase specifically: Project Settings -> Storage -> S3 Connection.
# REC_S3_ACCESS_KEY_ID=""
# REC_S3_SECRET_ACCESS_KEY=""
# REC_S3_BUCKET_NAME="resources"
# REC_S3_ENDPOINT_URL="https://xxxxxxxxxxxx.supabase.co/storage/v1/s3"
# REC_S3_REGION_NAME="us-east-1"

# --- Authentication --------------------------------------------------------
REC_ACCESS_TOKEN_MINUTES="60"
REC_REFRESH_TOKEN_DAYS="7"

# Optional. Restrict student self-registration to one domain,
# e.g. "rajalakshmi.edu.in". Leave blank to allow any address.
REC_ALLOWED_STUDENT_EMAIL_DOMAIN=""

# --- CORS ------------------------------------------------------------------
# In production the SPA is served by Django from the same origin, so this stays
# empty. Set it only if the frontend is hosted separately.
# Never use CORS_ALLOW_ALL_ORIGINS — localhost origins are permitted in DEBUG only.
REC_CORS_ORIGINS=""

# --- WhatsApp bot (backend/.env) --------------------------------------------
# All free — see whatsapp/README.md for how to get each value and run the bot
# with zero WhatsApp credentials at all (dry-run mode, on by default here).
# WHATSAPP_VERIFY_TOKEN="choose-any-random-string"
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_DRY_RUN="1"

# Free-tier LLM (Groq) used only to clean up a messy subject phrase. Blank is
# fine — the bot falls back to a regex-based extractor with no LLM at all.
# GROQ_API_KEY=""

# --- Frontend (frontend/.env) ----------------------------------------------
# Leave unset for the normal same-origin setup: the Vite dev server proxies
# /api to Django, and the production build is served by Django itself.
# VITE_API_BASE_URL="https://api.example.edu"

# Not used by the app yet — the frontend talks only to the Django API above,
# never to Supabase directly. Reserved for a future phase (e.g. Supabase Auth
# or client-side Storage access). Only the anon/publishable key belongs here;
# it is safe to expose in a browser bundle. Never put a service-role key, or a
# database connection string, in a VITE_ variable — anything with that prefix
# ships in the built JavaScript for anyone to read.
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_PUBLISHABLE_KEY=""
