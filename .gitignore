# Python
__pycache__/
*.py[cod]
backend/venv/
backend/.venv/
.python-version

# Django
backend/*.sqlite3
backend/*.sqlite3-wal
backend/*.sqlite3-shm
backend/staticfiles/
# Uploaded resource files — never commit user content
backend/media/
# Source material for `ingest_studies` — already published to Supabase
# Storage; the raw files do not belong in git.
/studies/

# Node / Vite
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Environment — secrets must not be committed
.env
.env.*
!.env.example

# Legacy database snapshot taken before the migration
.legacy-backup/

# Data-migration working files — backups and fixture dumps that may hold
# real user/academic data (and, for a user fixture, a password hash). Never
# committed; regenerable from the databases at any time.
backend/.backups/
backend/.migration_fixtures/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
